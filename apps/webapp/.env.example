# Midwest EA — environment variables
#
# Local dev (Next.js):
#   cp apps/webapp/.env.example apps/webapp/.env.local
#
# Root scripts (apply-migrations, list-tables, migration:*):
#   Copy the Supabase blocks into a .env.local at the repo root as well.
#
# Never commit .env or .env.local.
#
# Do not keep OLD_*, LIVE_*, or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Anon and service-role keys are different; never put the service role on NEXT_PUBLIC_*.

# ---------------------------------------------------------------------------
# Supabase — required (current / live project)
# Dashboard: Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases (scripts fall back to the NEXT_PUBLIC_* names above)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Management API token — root scripts only
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Supabase — migration scripts only (optional)
# Unprefixed vars above are what the app uses. These are only read by
# scripts/lib/migration-env.ts (npm run migration:check-env, etc.).
# ---------------------------------------------------------------------------
# MIGRATION_NEXT_PUBLIC_SUPABASE_URL=
# MIGRATION_NEXT_PUBLIC_SUPABASE_ANON_KEY=
# MIGRATION_SUPABASE_SERVICE_ROLE_KEY=
# MIGRATION_SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Stripe — required for checkout
# Use test keys locally (pk_test_ / sk_test_).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@midwestea.com

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional — admin "View on site" links (default: https://midwestea.vercel.app)
# NEXT_PUBLIC_MARKETING_SITE_URL=https://midwestea.vercel.app

# Optional — certificate / email site URL (default: https://midwestea.com)
# NEXT_PUBLIC_SITE_URL=https://midwestea.com

# ---------------------------------------------------------------------------
# Linear — client error reporting (server-only)
# Dashboard: Settings → Account → Security & access → Personal API keys
# ---------------------------------------------------------------------------
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_ERROR_PROJECT_ID=
LINEAR_ERROR_LABELS=auto-error,client-error

# ---------------------------------------------------------------------------
# QuickBooks (optional — admin invoice reconcile)
# See docs/quickbooks-oauth-setup.md
# ---------------------------------------------------------------------------
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_COMPANY_ID=
# QUICKBOOKS_REALM_ID=
# QUICKBOOKS_ACCESS_TOKEN=
# QUICKBOOKS_REFRESH_TOKEN=
# QUICKBOOKS_USE_SANDBOX=true
