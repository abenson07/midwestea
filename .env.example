# Repo-root environment variables (scripts only)
#
# Next.js reads apps/webapp/.env.local — use apps/webapp/.env.example as the
# full template. Copy the Supabase section here for root scripts:
#
#   cp apps/webapp/.env.example .env.local
#
# Scripts that load this file: apply-migrations, list-tables, migration:*

# --- Current Supabase (same values as apps/webapp/.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN=

# --- Migration target (optional; scripts/lib/migration-env.ts only) ---
# MIGRATION_NEXT_PUBLIC_SUPABASE_URL=
# MIGRATION_NEXT_PUBLIC_SUPABASE_ANON_KEY=
# MIGRATION_SUPABASE_SERVICE_ROLE_KEY=
# MIGRATION_SUPABASE_ACCESS_TOKEN=
